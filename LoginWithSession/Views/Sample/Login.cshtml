@model LoginModel
@{
}

<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm())
        {
            <div class="card">
                <div class="card-header">
                    <h4>Login Form</h4>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label>User Name</label>
                        @Html.TextBoxFor(e=>e.UserName,new {@class="form-control"})
                    </div>
                    <div class="mb-3">
                        <label>Password</label>
                        @Html.PasswordFor(e=>e.Password,new {@class="form-control"})
                    </div>
                </div>
                <div class="card-footer">
                    <input type="submit" value="Login" class="btn btn-primary" />
                    <h4 class="text-danger">@ViewBag.msg</h4>               
                </div>

            </div>
        }
    </div>
</div>
